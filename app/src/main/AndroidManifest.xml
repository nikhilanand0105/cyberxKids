<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for threat reputation lookup -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional location only for emergency SOS dispatch -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Phone dialer permission for Helpline 1930 quick action in Senior Mode -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- 
      iQOO 15 Optimization: 64-bit arm64-v8a target.
      We deliberately OMIT REQUEST_INSTALL_PACKAGES to comply with Google Play Policy.
      Saathi delegates package installation to Android's native PackageInstaller via Intent.ACTION_VIEW.
    -->

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:label="Saathi"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saathi">

        <!-- Support 22:10 ultra-tall display on iQOO 15 (1440x3168) -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.5" />

        <!-- Main Home & Live Scanner Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|density"
            android:windowSoftInputMode="adjustResize">

            <!-- Default Launcher Intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 1. Intercept "Open With" for downloaded APK files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>

            <!-- 2. Intercept "Share via Saathi" from Chrome, WhatsApp, Files -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>

        </activity>

        <!-- Secure Scoped Storage FileProvider -->
        <provider
            android:name="dev.saathi.personal.provider.SaathiFileProvider"
            android:authorities="dev.saathi.personal.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
