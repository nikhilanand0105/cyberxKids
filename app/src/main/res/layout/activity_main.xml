<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAATHI"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your AI Companion for Digital Safety"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <!-- iQOO 15 Hardware Accelerator Status Pill -->
            <TextView
                android:id="@+id/tv_device_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#312E81"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="⚡ iQOO 15 • Snapdragon 8 Elite • 144Hz Active"
                android:textColor="#A5B4FC"
                android:textSize="11sp"
                android:singleLine="true"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode & Language Toggle Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_toggle_senior"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/surface_card"
                android:text="Senior Mode: OFF"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_toggle_lang"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/surface_card"
                android:text="भाषा: English"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- National Cyber Crime Helpline Card (1930) -->
        <LinearLayout
            android:id="@+id/card_helpline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#3A2304"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_helpline_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 National Cyber Crime Helpline (India)"
                android:textColor="#FDE68A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_helpline_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="If an unknown caller persuaded you to send money or share an OTP, dial 1930 immediately to freeze fraudulent bank transactions."
                android:textColor="#FEF3C7"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_call_1930"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#D97706"
                android:text="Call 1930 Immediately"
                android:textColor="@color/text_white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live APK Shield Scanner Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/surface_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saathi Shield — APK Intelligence"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Static reverse-engineering on Snapdragon 8 Elite: DEX opcodes, permissions &amp; signatures inspected offline."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_simulate_banking_trojan"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#7F1D1D"
                    android:text="Test Trojan APK"
                    android:textColor="#FCA5A5"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_simulate_clean_apk"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#064E3B"
                    android:text="Test Clean APK"
                    android:textColor="#6EE7B7"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Verdict Display Area -->
            <LinearLayout
                android:id="@+id/verdict_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/background_dark"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_verdict_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#991B1B"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="VERDICT: READY"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_verdict_advice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap a button above to test the APK intelligence engine."
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_verdict_evidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Evidence: None"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_install_action"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#334155"
                    android:text="System Installer Handoff"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Child Online Safety & Hinglish Sense Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@color/surface_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saathi Sense — Child Safety &amp; Hinglish NLP"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sense_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tested: 'Camera on kar video call pe, kisi ko mat batana' -> GROOMING RISK [SOS ACTIVE]"
                android:textColor="#FCA5A5"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
